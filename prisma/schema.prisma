generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITORIA
}
enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  FINALIZADO
}
enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  ROTEADOR
  CABO_ESTRUTURADO
  FONTE_ALIMENTACAO
}
enum StatusRastreamento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_DESMONTE
  EM_DESMONTE
  PECAS_REAPROVEITADAS
  MATERIAL_RECICLAVEL
  DESCARTE_SEGURO
  BAIXA_DEFINITIVA
}

model Usuario {
  id String @id @default(uuid()) @db.Uuid
  usuario String @unique
  hashSenha String
  papel PapelUsuario
  ativo Boolean @default(true)
  ultimoAcesso DateTime?
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  versao Int @default(1)
  @@map("usuarios")
}
model Organizacao {
  id String @id @default(uuid()) @db.Uuid
  razaoSocial String
  cnpj String @unique @db.Char(14)
  inscricaoEstadual String
  enderecoCompleto String
  telefone String
  email String
  dataCadastro DateTime @default(now())
  ativo Boolean @default(true)
  versao Int @default(1)
  contrato Contrato?
  lotes Lote[]
  @@map("organizacoes")
}
model Contrato {
  id String @id @default(uuid()) @db.Uuid
  organizacaoId String @unique @db.Uuid
  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  dataAssinatura DateTime
  dataVencimento DateTime
  clausulas Json @default("[]")
  valorMensal Decimal @db.Decimal(12, 2)
  renovacaoAutomatica Boolean @default(true)
  versao Int @default(1)
  @@map("contratos")
}
model Lote {
  id String @id @default(uuid()) @db.Uuid
  dataEntrada DateTime
  organizacaoId String @db.Uuid
  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  notaFiscal String
  transportadora String
  statusProcessamento StatusLote @default(RECEBIDO)
  observacoes String @default("")
  versao Int @default(1)
  equipamentos Equipamento[]
  @@index([organizacaoId])
  @@index([dataEntrada])
  @@index([statusProcessamento])
  @@map("lotes")
}
model Equipamento {
  id String @id @default(uuid()) @db.Uuid
  codigoBarrasInterno String @unique
  tipo TipoEquipamento
  marca String
  modelo String
  anoFabricacao Int
  estadoFisico Int
  pesoQuilogramas Decimal @db.Decimal(10, 3)
  loteId String @db.Uuid
  lote Lote @relation(fields: [loteId], references: [id], onDelete: Restrict)
  posicaoNoLote Int
  statusRastreamento StatusRastreamento @default(AGUARDANDO_TRIAGEM)
  versao Int @default(1)
  movimentacoes Movimentacao[]
  @@unique([loteId, posicaoNoLote])
  @@index([loteId])
  @@index([statusRastreamento])
  @@map("equipamentos")
}
model Movimentacao {
  id String @id @default(uuid()) @db.Uuid
  equipamentoId String @db.Uuid
  equipamento Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)
  dataHora DateTime @default(now())
  origem String
  destino String
  responsavel String
  observacao String @default("")
  versao Int @default(1)
  @@index([equipamentoId, dataHora])
  @@map("movimentacoes")
}
model JournalTransacao {
  id String @id @default(uuid()) @db.Uuid
  timestamp DateTime @default(now())
  operacao String
  entidade String
  entidadeId String?
  dadosAntes Json?
  dadosDepois Json?
  usuarioResponsavel String
  versao Int @default(1)
  @@index([timestamp])
  @@index([entidade, entidadeId])
  @@map("journal_transacoes")
}
